{
  "schemaVersion": 1,
  "id": "rain",
  "name": "Rain Pass",
  "category": "Atmosphere",
  "version": "1.0.0",
  "summary": "Layer rain streaks, intensity, and foreground/background depth separation.",
  "tags": ["rain", "weather", "depth"],
  "preview": { "kind": "illustrated-demo", "label": "Synthetic plate · weather preview" },
  "inputs": ["source-video", "optional-depth-map"],
  "outputs": ["particle-layer", "depth-mask"],
  "parameters": [
    { "id": "intensity", "label": "Rain density", "group": "Particles", "type": "range", "default": 0.45, "min": 0, "max": 1, "step": 0.01 },
    { "id": "wind", "label": "Wind angle", "group": "Motion", "type": "range", "default": 0.2, "min": -1, "max": 1, "step": 0.01 },
    { "id": "speed", "label": "Drop speed", "group": "Motion", "type": "range", "default": 0.7, "min": 0, "max": 1, "step": 0.01 }
  ],
  "capabilities": { "ai": ["video-generation", "depth-estimation"], "mcp": ["composite.add-layer"], "davinci": ["fusion.add-layer"] },
  "execution": { "mode": "demo", "adapter": "composite.weather-particles", "safety": "media-compositing-only" }
}
