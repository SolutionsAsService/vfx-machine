    { "id": "radial", "label": "Radial falloff", "group": "Optics", "type": "range", "default": 0.5, "min": 0, "max": 1, "step": 0.01 },
    { "id": "opacity", "label": "Opacity", "group": "Composite", "type": "range", "default": 0.82, "min": 0, "max": 1, "step": 0.01 }
  ],
  "capabilities": { "ai": [], "mcp": ["composite.add-layer"], "davinci": ["fusion.distort"] },
  "execution": { "mode": "demo", "adapter": "composite.channel-separation", "safety": "media-compositing-only" }
}
