{
  "schemaVersion": 1,
  "id": "chromatic-aberration",
  "name": "Chromatic Aberration",
  "category": "Camera",
  "version": "1.0.0",
  "summary": "Add controllable channel separation with a reversible optical-distortion pass.",
  "tags": ["lens", "rgb", "distortion"],
  "preview": { "kind": "illustrated-demo", "label": "Synthetic plate · optical preview" },
