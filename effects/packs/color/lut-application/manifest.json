{
  "schemaVersion": 1,
  "id": "lut-application",
  "name": "3D LUT Apply",
  "category": "Color",
  "version": "1.0.0",
  "summary": "Attach a validated 3D .cube look to the color pipeline with adjustable mix.",
  "tags": ["lut", "color", "look-development"],
  "preview": { "kind": "illustrated-demo", "label": "Approximate preview · LUT is not applied in this build" },
  "inputs": ["source-video", "cube-lut"],
  "outputs": ["lut-operation", "grade-settings"],
  "parameters": [
    { "id": "intensity", "label": "Mix", "group": "Apply", "type": "range", "default": 1, "min": 0, "max": 1, "step": 0.01 },
    { "id": "interpolation", "label": "Interpolation", "group": "Apply", "type": "select", "default": "trilinear", "options": ["trilinear", "tetrahedral", "nearest"] },
    { "id": "enabled", "label": "Enable LUT", "group": "Apply", "type": "toggle", "default": true }
  ],
  "capabilities": { "ai": [], "mcp": ["color.apply-lut"], "davinci": ["color.apply-lut"] },
  "execution": { "mode": "demo", "adapter": "color.lut", "safety": "non-destructive-color-operation" }
}
