{
  "schemaVersion": 1,
  "id": "black-and-white",
  "name": "Black & White",
  "category": "Film Looks",
  "version": "1.0.0",
  "summary": "A reversible monochrome treatment with contrast and split-toning controls.",
  "tags": ["monochrome", "film-look", "color"],
  "preview": { "kind": "illustrated-demo", "label": "CSS approximation · look preview" },
  "inputs": ["source-video"],
  "outputs": ["grade-settings"],
  "parameters": [
    { "id": "intensity", "label": "Monochrome mix", "group": "Look", "type": "range", "default": 1, "min": 0, "max": 1, "step": 0.01 },
    { "id": "contrast", "label": "Contrast", "group": "Tone", "type": "range", "default": 0.1, "min": -1, "max": 1, "step": 0.01 },
    { "id": "grain", "label": "Grain", "group": "Texture", "type": "range", "default": 0.08, "min": 0, "max": 1, "step": 0.01 }
  ],
  "capabilities": { "ai": [], "mcp": ["color.set-primary"], "davinci": ["color.create-node", "color.set-primary"] },
  "execution": { "mode": "demo", "adapter": "color.monochrome", "safety": "non-destructive-color-operation" }
}
