{
  "schemaVersion": 1,
  "id": "cinematic-grade",
  "name": "Cinematic Grade",
  "category": "Color",
  "version": "1.0.0",
  "summary": "A look-development starting point with independent exposure, contrast, and saturation.",
  "tags": ["color", "grade", "look-development"],
  "preview": { "kind": "illustrated-demo", "label": "CSS approximation · not a color-managed render" },
  "inputs": ["source-video", "optional-reference-still"],
  "outputs": ["grade-settings", "operation-manifest"],
  "parameters": [
    { "id": "exposure", "label": "Exposure", "group": "Primary", "type": "range", "default": 0.08, "min": -1, "max": 1, "step": 0.01, "unit": "EV" },
    { "id": "contrast", "label": "Contrast", "group": "Primary", "type": "range", "default": 0.18, "min": -1, "max": 1, "step": 0.01 },
    { "id": "saturation", "label": "Saturation", "group": "Primary", "type": "range", "default": 0.12, "min": -1, "max": 1, "step": 0.01 },
    { "id": "temperature", "label": "Temperature", "group": "Balance", "type": "range", "default": 0.06, "min": -1, "max": 1, "step": 0.01 }
  ],
  "capabilities": { "ai": ["image-analysis", "look-matching"], "mcp": ["color.set-primary"], "davinci": ["color.create-node", "color.set-primary"] },
  "execution": { "mode": "demo", "adapter": "color.primary-grade", "safety": "non-destructive-color-operation" }
}
