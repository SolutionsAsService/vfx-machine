{
  "schemaVersion": 1,
  "id": "muzzle-flash",
  "name": "Muzzle Flash",
  "category": "Action",
  "version": "1.0.0",
  "summary": "Layer a frame-accurate flash element with optional bloom and illumination pass.",
  "tags": ["flash", "light", "action"],
  "preview": { "kind": "illustrated-demo", "label": "Synthetic plate · preview overlay" },
  "inputs": ["source-video", "frame-range", "emitter-position"],
  "outputs": ["flash-layer", "light-wrap-layer"],
  "parameters": [
    { "id": "intensity", "label": "Intensity", "group": "Flash", "type": "range", "default": 0.7, "min": 0, "max": 1, "step": 0.01 },
    { "id": "duration", "label": "Duration", "group": "Timing", "type": "range", "default": 3, "min": 1, "max": 12, "step": 1, "unit": "frames" },
    { "id": "temperature", "label": "Color temperature", "group": "Light", "type": "range", "default": 0.65, "min": 0, "max": 1, "step": 0.01 },
    { "id": "bloom", "label": "Bloom", "group": "Light", "type": "range", "default": 0.38, "min": 0, "max": 1, "step": 0.01 }
  ],
  "capabilities": { "ai": ["video-generation"], "mcp": ["composite.add-layer", "timeline.set-keyframes"], "davinci": ["fusion.add-layer", "timeline.set-keyframes"] },
  "execution": { "mode": "demo", "adapter": "composite.flash", "safety": "media-compositing-only" }
}
