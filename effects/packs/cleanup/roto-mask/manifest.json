{
  "schemaVersion": 1,
  "id": "roto-mask",
  "name": "Rotoscope Mask",
  "category": "Cleanup",
  "version": "1.0.0",
  "summary": "Create a subject matte request with edge refinement and temporal propagation.",
  "tags": ["rotoscoping", "mask", "segmentation"],
  "preview": { "kind": "illustrated-demo", "label": "Illustrative matte preview · no AI segmentation connected" },
  "inputs": ["source-video", "frame-range"],
  "outputs": ["alpha-matte", "tracked-spline"],
  "parameters": [
    { "id": "edge", "label": "Edge refinement", "group": "Matte", "type": "range", "default": 0.58, "min": 0, "max": 1, "step": 0.01 },
    { "id": "propagation", "label": "Temporal propagation", "group": "Tracking", "type": "range", "default": 0.76, "min": 0, "max": 1, "step": 0.01 },
    { "id": "matteMode", "label": "Matte output", "group": "Output", "type": "select", "default": "alpha", "options": ["alpha", "holdout", "garbage-matte"] }
  ],
  "capabilities": { "ai": ["segmentation", "rotoscoping", "tracking"], "mcp": ["mask.create", "tracking.track-mask"], "davinci": ["fusion.create-mask", "fusion.track"] },
  "execution": { "mode": "demo", "adapter": "cleanup.roto-mask", "safety": "non-destructive-media-edit" }
}
